# Example .env file for the Air Hockey Flutter frontend.
# Copy this file to .env and update the values for your environment.

# Use 127.0.0.1 for desktop and local development.
# Use 10.0.2.2 for Android emulator if the backend runs on the host machine.
HTTP_BASE_URL=http://[IP_ADDRESS]:8080
UDP_HOST=[IP_ADDRESS]
UDP_PORT=8050
